# Token of the tunnel you created in the Cloudflare dashboard
# (Zero Trust → Networks → Tunnels → your tunnel → the long string after --token).
TUNNEL_TOKEN=

# Cloudflare API token with:
#   Account → Cloudflare Tunnel → Edit
#   Zone    → Zone              → Read
#   Zone    → DNS               → Edit
# scoped to the zones (domains) you want to use.
CF_API_TOKEN=

# Optional: only manage these zones (comma separated). Default: every zone the token can see.
ZONES=

# Optional: seconds between sync passes.
INTERVAL=30
