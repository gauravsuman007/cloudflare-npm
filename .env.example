# Everything here is optional.
#
# Leave TUNNEL_TOKEN and CF_API_TOKEN empty to set up by clicking a login link
# (see `docker compose logs cloudflared`). Fill both in to use a tunnel created
# in the Cloudflare dashboard instead; see the README.

# Name of the tunnel created in login mode.
TUNNEL_NAME=cloudflare-npm

# Token of a tunnel created in the dashboard
# (Zero Trust → Networks → Tunnels → your tunnel → the long string after --token).
TUNNEL_TOKEN=

# API token used with TUNNEL_TOKEN, with:
#   Account → Cloudflare Tunnel → Edit
#   Zone    → Zone              → Read
#   Zone    → DNS               → Edit
# scoped to the zones (domains) you want to use.
CF_API_TOKEN=

# Only manage these zones (comma separated). Default: every zone the credentials can see.
ZONES=

# Seconds between sync passes.
INTERVAL=30
